{
  "name": "fastify-standard-schema",
  "version": "5.0.2",
  "description": "Fastify validation, serialization, and type-provider support for Standard Schema",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "benchmark": "pnpm build && node benchmarks/run.mjs",
    "benchmark:quick": "pnpm build && node benchmarks/run.mjs --quick",
    "test": "pnpm build && vitest run --typecheck && node test/exports-smoke.cjs"
  },
  "keywords": [
    "fastify",
    "standard-schema",
    "validation",
    "serialization",
    "type-provider"
  ],
  "peerDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^24.0.0",
    "autocannon": "^8.0.0",
    "@vinejs/vine": "^4.4.0",
    "fastify": "^5.12.1",
    "joi": "^18.2.5",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yup": "^1.7.1",
    "zod": "^4.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
