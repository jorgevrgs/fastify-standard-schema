{
  "name": "fastify-standard-schema",
  "version": "5.0.0",
  "description": "Fastify validation, serialization, and type-provider support for Standard Schema",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm build && vitest run --typecheck && node test/exports-smoke.cjs"
  },
  "keywords": ["fastify", "standard-schema", "validation", "serialization", "type-provider"],
  "peerDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^22.13.11",
    "@vinejs/vine": "^4.3.0",
    "fastify": "^5.2.1",
    "joi": "^18.0.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "vitest": "4.1.0",
    "yup": "^1.7.1",
    "zod": "^4.0.0"
  }
}
