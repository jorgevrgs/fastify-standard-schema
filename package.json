{
  "name": "fastify-standard-schema",
  "version": "0.1.0",
  "description": "Fastify validation, serialization, and type-provider support for Standard Schema",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "fastify",
    "standard-schema",
    "validation",
    "serialization",
    "type-provider"
  ],
  "peerDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^22.13.11",
    "fastify": "^5.2.1",
    "typescript": "^5.8.2",
    "zod": "^4.0.0"
  }
}
